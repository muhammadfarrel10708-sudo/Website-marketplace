APP_NAME="Nama Brand API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Harus sama dengan alamat saat menjalankan "php artisan serve"
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database: MySQL bawaan XAMPP ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=videotron
DB_USERNAME=root
DB_PASSWORD=

# API tidak memakai session/queue, jadi cukup driver sederhana
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# --- Alamat website React yang boleh memanggil API ini (pisahkan dengan koma) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Akun admin (dibuat oleh: php artisan db:seed) ---
# GANTI password ini sebelum website dipublikasikan.
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
# Lama login berlaku (jam)
ADMIN_TOKEN_HOURS=8

# --- Akun admin Nusatron ---
NUSATRON_ADMIN_NAME=Admin Nusatron
NUSATRON_ADMIN_USERNAME=nusatron
NUSATRON_ADMIN_EMAIL=nusatron@example.com
NUSATRON_ADMIN_PASSWORD=admin12345
